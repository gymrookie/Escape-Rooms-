async function nextQ(){
  const room=ROOMS.find(r=>r.id===S.currentRoomId);
  if(S.currentQ<room.questions.length-1){
    S.currentQ++;S.sataSelected=new Set();
    if(!S.isSolo){const rd=await sGet(`rm:${S.roomCode}`,true);if(rd){rd.answers={};rd.currentQ=S.currentQ;await sSet(`rm:${S.roomCode}`,rd,true);}}
    renderQuestion();
  } else {await completeRoom();}
}
function backToHub(){showScreen('game');renderGameHub();}

async function completeRoom(){
  const room=ROOMS.find(r=>r.id===S.currentRoomId);
  if(!S.completedRooms.includes(room.id)){
    S.completedRooms.push(room.id);S.roomScores[room.id]=S.myRoomScore;
    if(!S.isSolo){
      const rd=await sGet(`rm:${S.roomCode}`,true);
      if(rd){if(!rd.completedRooms.includes(room.id))rd.completedRooms.push(room.id);rd.teamHearts=3;await sSet(`rm:${S.roomCode}`,rd,true);}
      S.teamHearts=3;
    }
  }
  document.getElementById('rc-sub').textContent=`"${room.name}" cleared!`;
  let scoresHtml='';
  if(S.isSolo){scoresHtml=`<div class="rc-ps winner"><div class="rc-ps-name">🧑‍⚕️ ${S.myName}</div><div class="rc-ps-val">${S.myRoomScore}</div></div>`;}
  else{
    const rd=await sGet(`rm:${S.roomCode}`,true);
    if(rd)scoresHtml=Object.values(rd.players).sort((a,b)=>b.score-a.score).map((p,i)=>`<div class="rc-ps${i===0?' winner':''}"><div class="rc-ps-name">${p.avatar} ${p.name}</div><div class="rc-ps-val">${p.score}</div></div>`).join('');
  }
  document.getElementById('rc-scores').innerHTML=scoresHtml;
  document.getElementById('kf-box').innerHTML=`<div class="kf-title">📚 Key Clinical Facts — ${room.name}</div><ul class="kf-list">${room.keyfacts.map(f=>`<li>${f}</li>`).join('')}</ul>`;
  const idx=ROOMS.findIndex(r=>r.id===S.currentRoomId);
  const btn=document.getElementById('btn-next-room');
  if(idx<ROOMS.length-1){btn.style.display='inline-block';btn.textContent=`Next: ${ROOMS[idx+1].name} →`;}
  else btn.style.display='none';
  showScreen('rcomplete');
  if(S.completedRooms.length===ROOMS.length)setTimeout(showFinal,1800);
}
function goNextRoom(){const idx=ROOMS.findIndex(r=>r.id===S.currentRoomId);if(idx<ROOMS.length-1)enterRoom(ROOMS[idx+1].id);}

async function showFinal(){
  let podHtml='';
  const medals=['🥇','🥈','🥉'];
  if(S.isSolo){const total=Object.values(S.roomScores).reduce((a,b)=>a+b,0);podHtml=`<div class="podium-item"><div class="podium-rank">🥇</div><div class="podium-name">${S.myName}</div><div class="podium-score">${total}</div></div>`;}
  else{const rd=await sGet(`rm:${S.roomCode}`,true);if(rd)Object.values(rd.players).sort((a,b)=>b.score-a.score).slice(0,3).forEach((p,i)=>{podHtml+=`<div class="podium-item"><div class="podium-rank">${medals[i]||'🏅'}</div><div class="podium-name">${p.avatar} ${p.name}</div><div class="podium-score">${p.score}</div></div>`;});}
  document.getElementById('final-podium').innerHTML=podHtml;
  showScreen('final');stopPolling();
}

