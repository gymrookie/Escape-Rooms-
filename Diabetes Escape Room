function renderGameHub(){
  document.getElementById('gt-room').textContent=S.isSolo?'SOLO':`ROOM ${S.roomCode}`;
  document.getElementById('gt-title').textContent=S.myName+"'s Game";
  const h=S.teamHearts;
  document.getElementById('top-hearts').textContent='❤️'.repeat(h)+'🖤'.repeat(3-h);
  document.getElementById('top-score').textContent=Object.values(S.roomScores).reduce((a,b)=>a+b,0);
  renderScoreboard();
  const grid=document.getElementById('room-grid-game');
  grid.innerHTML=ROOMS.map((room,i)=>{
    const done=S.completedRooms.includes(room.id);
    const locked=i>0&&!S.completedRooms.includes(ROOMS[i-1].id);
    const cls=done?'rs-done':locked?'rs-locked':'rs-open';
    const lbl=done?'Completed':locked?'Locked':'Available';
    return `<div class="rcard ${room.color}${done?' completed':locked?' locked':''}" onclick="${locked?'':` enterRoom('${room.id}')`}">
      <div class="rcard-eye">${room.icon} ${done?'✓ ':locked?'🔒 ':''}${room.subtitle}</div>
      <div class="rcard-name">${room.name}</div>
      <div class="rcard-desc">${room.desc}</div>
      <div class="rcard-foot"><span>${room.questions.length} challenges</span><span class="rcard-status ${cls}">${lbl}${done&&S.roomScores[room.id]?' · '+S.roomScores[room.id]+'pts':''}</span></div>
    </div>`;
  }).join('');
}
async function renderScoreboard(){
  const strip=document.getElementById('scoreboard-strip');
  if(S.isSolo){
    const total=Object.values(S.roomScores).reduce((a,b)=>a+b,0);
    strip.innerHTML=`<div class="sb-player me"><div class="sb-avatar">🧑‍⚕️</div><div><div class="sb-name">${S.myName} (You)</div><div class="sb-score">${total} pts</div></div></div>`;
    return;
  }
  const rd=await sGet(`rm:${S.roomCode}`,true);if(!rd)return;
  strip.innerHTML=Object.values(rd.players).sort((a,b)=>b.score-a.score).map(p=>`<div class="sb-player${p.id===S.myId?' me':''}"><div class="sb-avatar">${p.avatar}</div><div><div class="sb-name">${p.name}${p.id===S.myId?' (You)':''}</div><div class="sb-score">${p.score} pts</div></div></div>`).join('');
}

