  showLoading(false);loadGame(rd);
}
function loadGame(rd){
  S.completedRooms=rd.completedRooms||[];S.teamHearts=rd.teamHearts;
  showScreen('game');renderGameHub();
}
function copyCode(){navigator.clipboard?.writeText(S.roomCode).then(()=>toast('Code copied! 📋','teal'));}

// Polling
function startPolling(){stopPolling();S.pollTimer=setInterval(pollRoom,2000);}
function stopPolling(){if(S.pollTimer){clearInterval(S.pollTimer);S.pollTimer=null;}}
async function pollRoom(){
  if(S.isSolo||!S.roomCode)return;
  const rd=await sGet(`rm:${S.roomCode}`,true);if(!rd)return;
  S.teamHearts=rd.teamHearts;
  const cur=document.querySelector('.screen.active')?.id;
  if(cur==='waiting'){renderWaiting(rd);if(rd.gameStarted&&!S.isHost){S.completedRooms=rd.completedRooms||[];loadGame(rd);}return;}
  if(cur==='game'){S.completedRooms=rd.completedRooms||[];renderGameHub();return;}
  if(cur==='qscreen'){syncAnswerTracker(rd);return;}
}

