    cont.innerHTML=`<div class="as-section-hdr">📐 All Weight-Based Dosage Formulas</div>`
      +dosQs.map(({room,q})=>`<div class="as-q-item">
        <div class="as-q-meta">${room.icon} ${room.name} &nbsp;•&nbsp; ${q.pts} pts &nbsp;•&nbsp; Dosage Calculation</div>
        <div class="as-q-scenario">⚖️ ${q.scenario}</div>
        <div class="as-q-text">${q.q}</div>
        <div class="as-formula-block"><strong>Formula:</strong><br>${q.formula}</div>
        <div class="as-answer-box">✓ Answer: ${q.ans} ${q.unit}</div>
        <div class="as-rationale">${q.explain}</div>
      </div>`).join('');
    return;
  }
  const room=ROOMS[idx];
  cont.innerHTML=`<div class="as-section-hdr">${room.icon} ${room.name} <span class="tag tag-teal">${room.subtitle}</span></div>
    <div class="as-kf"><h4>📚 Key Clinical Facts</h4><ul>${room.keyfacts.map(f=>`<li>${f}</li>`).join('')}</ul></div>
    ${room.questions.map((q,qi)=>{
      if(q.type==='mc'||!q.type){
        return `<div class="as-q-item">
          <div class="as-q-meta">Q${qi+1} of ${room.questions.length} &nbsp;•&nbsp; ${q.pts} pts &nbsp;•&nbsp; Multiple Choice</div>
          ${q.scenario?`<div class="as-q-scenario">📋 ${q.scenario}</div>`:''}
          <div class="as-q-text">${q.q}</div>
          <ul class="as-opts-list">${q.opts.map((o,i)=>`<li class="${i===q.ans?'correct':''}">${String.fromCharCode(65+i)}. ${o}${i===q.ans?' ← Correct':''}</li>`).join('')}</ul>
          <div class="as-rationale"><strong style="color:var(--teal);">Rationale:</strong> ${q.explain}</div>
        </div>`;
      } else if(q.type==='sata'){
        return `<div class="as-q-item">
          <div class="as-q-meta">Q${qi+1} of ${room.questions.length} &nbsp;•&nbsp; ${q.pts} pts &nbsp;•&nbsp; SATA (Select All That Apply)</div>
          ${q.scenario?`<div class="as-q-scenario">📋 ${q.scenario}</div>`:''}
          <div class="as-q-text">${q.q}</div>
          <ul class="as-opts-list">${q.opts.map((o,i)=>`<li class="${q.correctSet.includes(i)?'correct':''}">${String.fromCharCode(65+i)}. ${o}${q.correctSet.includes(i)?' ← Include':' ← Exclude'}</li>`).join('')}</ul>
          <div class="as-rationale"><strong style="color:var(--teal);">Rationale:</strong> ${q.explain}</div>
        </div>`;
      } else {
        return `<div class="as-q-item">
          <div class="as-q-meta">Q${qi+1} of ${room.questions.length} &nbsp;•&nbsp; ${q.pts} pts &nbsp;•&nbsp; ⚖️ Dosage Calculation</div>
          <div class="as-q-scenario">⚖️ ${q.scenario}</div>
          <div class="as-q-text">${q.q}</div>
          <div class="as-formula-block"><strong>Formula:</strong><br>${q.formula}</div>
          <div class="as-answer-box">✓ Answer: ${q.ans} ${q.unit}</div>
          <div class="as-rationale"><strong style="color:var(--teal);">Steps:</strong> ${q.explain}</div>
        </div>`;
      }
    }).join('')}
    <div style="background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:1.25rem;margin-top:1rem;">
      <div style="font-size:12px;font-weight:700;margin-bottom:6px;color:var(--text2);">🎯 Study Tip</div>
      <div style="font-size:13px;color:var(--text2);line-height:1.6;">Practice these until you can answer without referring to the rationale. For weight-based dosing, always write each step explicitly: (1) calculate dose in mg, (2) apply max cap if applicable, (3) convert to volume. Two-nurse verification is required for all high-alert medications including insulin, opioids, anticoagulants, and IV chemotherapy.</div>
    </div>`;
}
</script>
</body>
</html>
