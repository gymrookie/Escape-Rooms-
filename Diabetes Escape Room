<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NUR 242 — Mobility Unit 11/12 | Escape Room</title>
<style>
/* ── DESIGN TOKENS ──────────────────────────────────────── */
:root {
  /* Deep ocean-medical palette */
  --bg:        #07111a;
  --bg2:       #0d1e2b;
  --bg3:       #122636;
  --bg4:       #091520;
  --border:    #1a3347;
  --border2:   #234560;
  --teal:      #00c4b4;
  --teal-dim:  #002b28;
  --blue:      #3b9eff;
  --blue-dim:  #0a1f3d;
  --amber:     #f0a500;
  --amber-dim: #2d1e00;
  --red:       #f05252;
  --red-dim:   #3d1010;
  --green:     #22c55e;
  --green-dim: #0a2618;
  --purple:    #a78bfa;
  --purple-dim:#1c1040;
  --coral:     #fb923c;
  --coral-dim: #3d1800;
  --text:      #e2eff8;
  --text2:     #7fa8c0;
  --text3:     #3d637a;
  --mono:      'Courier New', monospace;
  --r:         10px;
  --shadow:    0 4px 24px rgba(0,0,0,.45);
}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'Segoe UI',system-ui,sans-serif;background:var(--bg);color:var(--text);min-height:100vh;overflow-x:hidden;}

/* ── SCREENS ──────────────────────────────────────────── */
.screen{display:none;min-height:100vh;flex-direction:column;}
.screen.active{display:flex;}

/* ── SHARED COMPONENTS ────────────────────────────────── */
.btn{border:none;border-radius:8px;padding:11px 22px;font-size:14px;font-weight:600;cursor:pointer;transition:all .15s;}
.btn:active{transform:scale(.97);}
.btn-primary{background:var(--teal);color:#000;}
.btn-primary:hover{background:#00a898;}
.btn-secondary{background:var(--bg3);border:1px solid var(--border2);color:var(--text);}
.btn-secondary:hover{background:#1a3347;}
.btn-danger{background:var(--red-dim);border:1px solid var(--red);color:var(--red);}
.btn-amber{background:var(--amber-dim);border:1px solid var(--amber);color:var(--amber);}
.btn-sm{padding:6px 14px;font-size:12px;}
.btn-full{width:100%;}
.tag{display:inline-block;padding:2px 9px;border-radius:20px;font-size:11px;font-weight:700;letter-spacing:.4px;}
.tag-teal{background:var(--teal-dim);color:var(--teal);}
.tag-blue{background:var(--blue-dim);color:var(--blue);}
.tag-amber{background:var(--amber-dim);color:var(--amber);}
.tag-green{background:var(--green-dim);color:var(--green);}
.form-group{display:flex;flex-direction:column;gap:5px;margin-bottom:.875rem;}
.form-label{font-size:11px;color:var(--text2);text-transform:uppercase;letter-spacing:1px;}
.form-input{background:var(--bg3);border:1px solid var(--border2);border-radius:8px;padding:10px 13px;font-size:14px;color:var(--text);}
.form-input:focus{outline:none;border-color:var(--teal);}
.form-input.code-input{font-family:var(--mono);font-size:1.8rem;font-weight:700;text-align:center;letter-spacing:8px;text-transform:uppercase;color:var(--teal);}
.panel{background:var(--bg2);border:1px solid var(--border);border-radius:14px;padding:1.75rem;max-width:460px;width:100%;}
.panel-title{font-size:1rem;font-weight:700;margin-bottom:1.25rem;}
.divider{height:1px;background:var(--border);margin:1rem 0;}

/* Toast / Loading */
.toast{position:fixed;bottom:1.5rem;left:50%;transform:translateX(-50%) translateY(80px);background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:.7rem 1.25rem;font-size:14px;font-weight:600;transition:transform .3s;z-index:999;pointer-events:none;white-space:nowrap;}
.toast.show{transform:translateX(-50%) translateY(0);}
.toast.teal{border-color:var(--teal);color:var(--teal);}
.toast.red{border-color:var(--red);color:var(--red);}
.toast.amber{border-color:var(--amber);color:var(--amber);}
.loading-overlay{position:fixed;inset:0;background:rgba(7,17,26,.85);display:flex;align-items:center;justify-content:center;z-index:100;display:none;}
.loading-overlay.show{display:flex;}
.spinner{width:34px;height:34px;border:3px solid var(--bg3);border-top-color:var(--teal);border-radius:50%;animation:spin .8s linear infinite;}
@keyframes spin{to{transform:rotate(360deg)}}

/* ════════════════════════════════════════════
   LOBBY
════════════════════════════════════════════ */
#lobby{align-items:center;justify-content:center;padding:2rem;
  background:radial-gradient(ellipse at 50% -5%, #0d2a3a 0%, #07111a 65%);}
.logo-badge{display:inline-flex;align-items:center;gap:7px;background:var(--teal-dim);border:1px solid var(--teal);color:var(--teal);border-radius:20px;padding:4px 15px;font-size:11px;letter-spacing:2px;text-transform:uppercase;margin-bottom:1.25rem;}
.logo-badge::before{content:'';width:6px;height:6px;background:var(--teal);border-radius:50%;animation:blink 1.6s ease-in-out infinite;}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
.logo-title{font-size:clamp(2rem,6vw,3.8rem);font-weight:800;letter-spacing:-2px;line-height:1.05;background:linear-gradient(135deg,#00c4b4,#3b9eff,#a78bfa);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;text-align:center;margin-bottom:.5rem;}
.logo-sub{color:var(--text2);font-size:14px;text-align:center;margin-bottom:2rem;letter-spacing:.3px;}
.lobby-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;max-width:560px;width:100%;margin-bottom:2rem;}
@media(max-width:500px){.lobby-grid{grid-template-columns:1fr;}}
.lobby-card{background:var(--bg2);border:1px solid var(--border);border-radius:13px;padding:1.5rem;text-align:center;cursor:pointer;transition:all .2s;}
.lobby-card:hover{border-color:var(--teal);transform:translateY(-3px);background:var(--bg3);}
.lc-icon{font-size:2.2rem;margin-bottom:.6rem;}
.lc-title{font-size:.95rem;font-weight:700;margin-bottom:.3rem;}
.lc-desc{font-size:12px;color:var(--text2);line-height:1.5;}
/* X-ray decoration */
.xray-strip{width:100%;max-width:380px;height:44px;background:var(--bg2);border:1px solid var(--border);border-radius:8px;overflow:hidden;margin:1rem auto;display:flex;align-items:center;justify-content:center;gap:3px;padding:0 12px;}
.bone-seg{height:8px;border-radius:4px;background:rgba(0,196,180,.2);flex:1;}
.bone-seg.lit{background:rgba(0,196,180,.6);}

/* ════════════════════════════════════════════
   PRESENTATION
════════════════════════════════════════════ */
#presentation{background:var(--bg);}
.pres-header{background:var(--bg2);border-bottom:1px solid var(--border);padding:.75rem 1.5rem;display:flex;align-items:center;gap:1rem;flex-wrap:wrap;}
.pres-title-bar{flex:1;}
.pres-title-bar h2{font-size:.95rem;font-weight:700;}
.pres-title-bar p{font-size:12px;color:var(--text2);}
.slide-counter{font-size:12px;font-family:var(--mono);color:var(--text2);background:var(--bg3);border:1px solid var(--border);border-radius:6px;padding:4px 10px;}
.pres-body{flex:1;display:flex;flex-direction:column;align-items:center;padding:1.5rem;overflow-y:auto;}
.slide-viewport{width:100%;max-width:900px;position:relative;}
.slide{display:none;background:var(--bg2);border:1px solid var(--border);border-radius:16px;overflow:hidden;box-shadow:var(--shadow);min-height:420px;position:relative;}
.slide.active{display:flex;flex-direction:column;}
/* Title slide */
.s-hero{background:linear-gradient(135deg,#091f30 0%,#0d2b40 50%,#091520 100%);align-items:center;justify-content:center;text-align:center;padding:3rem 2rem;min-height:480px;}
.s-hero-eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:3px;color:var(--teal);margin-bottom:1rem;}
.s-hero-title{font-size:clamp(2.2rem,5vw,3.5rem);font-weight:800;letter-spacing:-2px;line-height:1.1;margin-bottom:.75rem;background:linear-gradient(135deg,#fff 30%,#00c4b4);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.s-hero-sub{font-size:1rem;color:var(--text2);max-width:420px;line-height:1.6;}
.s-hero-tags{display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin-top:1.5rem;}
/* Content slide */
.s-content{padding:2rem 2.5rem;gap:0;}
.s-content-inner{flex:1;display:flex;flex-direction:column;gap:1.25rem;}
.slide-eyebrow{font-size:10px;text-transform:uppercase;letter-spacing:2px;color:var(--teal);margin-bottom:.25rem;font-weight:700;}
.slide-h1{font-size:1.7rem;font-weight:800;letter-spacing:-1px;margin-bottom:1rem;color:var(--text);}
.slide-h1 span{color:var(--teal);}
/* Two-column */
.s-two-col{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;flex:1;}
@media(max-width:600px){.s-two-col{grid-template-columns:1fr;}}
.s-col-card{background:var(--bg3);border:1px solid var(--border);border-radius:10px;padding:1.25rem;}
.s-col-card h3{font-size:14px;font-weight:700;margin-bottom:.75rem;display:flex;align-items:center;gap:8px;}
.s-col-card h3 .icon-circle{width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:13px;flex-shrink:0;}
.s-col-card ul{list-style:none;display:grid;gap:5px;}
.s-col-card li{font-size:13px;color:var(--text2);padding-left:16px;position:relative;line-height:1.45;}
.s-col-card li::before{content:'›';position:absolute;left:0;color:var(--teal);}
/* Icon grid */
.s-icon-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;flex:1;}
.icon-card{background:var(--bg3);border:1px solid var(--border);border-radius:10px;padding:1rem 1.125rem;display:flex;gap:10px;align-items:flex-start;}
.icon-card .ic-dot{width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;margin-top:1px;}
.icon-card .ic-body h4{font-size:13px;font-weight:700;margin-bottom:4px;}
.icon-card .ic-body p{font-size:12px;color:var(--text2);line-height:1.45;}
/* Stat row */
.s-stat-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:12px;}
.stat-box{background:var(--bg3);border:1px solid var(--border);border-radius:10px;padding:1rem;text-align:center;}
.stat-box .sv{font-size:2rem;font-weight:800;color:var(--teal);font-family:var(--mono);line-height:1;}
.stat-box .sl{font-size:11px;color:var(--text2);margin-top:4px;text-transform:uppercase;letter-spacing:.5px;}
/* Numbered steps */
.s-steps{display:grid;gap:10px;flex:1;}
.step-item{display:flex;gap:12px;align-items:flex-start;background:var(--bg3);border:1px solid var(--border);border-radius:10px;padding:1rem 1.125rem;}
.step-num{width:28px;height:28px;border-radius:50%;background:var(--teal);color:#000;font-size:13px;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;}
.step-body h4{font-size:13px;font-weight:700;margin-bottom:3px;}
.step-body p{font-size:12px;color:var(--text2);line-height:1.5;}
/* Alert / call-out */
.slide-alert{background:linear-gradient(90deg,rgba(240,82,82,.08),rgba(240,82,82,.02));border-left:3px solid var(--red);border-radius:0 8px 8px 0;padding:.875rem 1.125rem;font-size:13px;color:var(--text2);line-height:1.6;}
.slide-alert strong{color:var(--red);}
.slide-info{background:linear-gradient(90deg,rgba(0,196,180,.08),rgba(0,196,180,.02));border-left:3px solid var(--teal);border-radius:0 8px 8px 0;padding:.875rem 1.125rem;font-size:13px;color:var(--text2);line-height:1.6;}
.slide-info strong{color:var(--teal);}
/* Slide nav */
.slide-nav{display:flex;align-items:center;justify-content:center;gap:1rem;padding:1rem;flex-wrap:wrap;}
.slide-dots{display:flex;gap:5px;flex-wrap:wrap;max-width:400px;justify-content:center;}
.sdot{width:7px;height:7px;border-radius:50%;background:var(--bg3);border:1px solid var(--border2);cursor:pointer;transition:all .15s;}
.sdot.active{background:var(--teal);border-color:var(--teal);width:18px;border-radius:4px;}
.sdot.done{background:var(--border2);}

/* ════════════════════════════════════════════
   WAITING ROOM
════════════════════════════════════════════ */
#waiting{background:var(--bg4);}
.wait-header{background:var(--bg2);border-bottom:1px solid var(--border);padding:.875rem 1.5rem;display:flex;align-items:center;gap:1rem;flex-wrap:wrap;}
.room-code-pill{background:var(--teal-dim);border:1px solid var(--teal);color:var(--teal);border-radius:8px;padding:5px 14px;font-family:var(--mono);font-size:1.3rem;font-weight:700;letter-spacing:4px;}
.wait-body{flex:1;padding:2rem;max-width:700px;margin:0 auto;width:100%;}
.wait-info{background:var(--teal-dim);border:1px solid var(--teal);border-radius:10px;padding:1rem 1.25rem;margin-bottom:1.5rem;font-size:13px;color:var(--teal);line-height:1.6;}
.players-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin-bottom:1.5rem;}
.player-slot{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:.875rem;text-align:center;}
.player-slot.filled{border-color:var(--teal);background:var(--bg3);}
.player-slot.empty{opacity:.35;}
.ps-avatar{font-size:1.6rem;margin-bottom:5px;}
.ps-name{font-size:12px;font-weight:600;}
.ps-badge{font-size:11px;color:var(--text3);margin-top:2px;}
.ps-badge.host{color:var(--amber);}

/* ════════════════════════════════════════════
   GAME HUB
════════════════════════════════════════════ */
#game{background:var(--bg);}
.game-topbar{background:var(--bg2);border-bottom:1px solid var(--border);padding:.5rem 1.5rem;display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
.gt-room{font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:1.5px;}
.gt-title{font-size:.9rem;font-weight:700;flex:1;}
.vital-chip{background:var(--bg3);border:1px solid var(--border);border-radius:6px;padding:3px 10px;font-size:11px;font-family:var(--mono);display:flex;align-items:center;gap:5px;}
.vc-label{color:var(--text3);}
.vc-val{color:var(--teal);font-weight:700;}
.scoreboard-strip{background:var(--bg4);border-bottom:1px solid var(--border);padding:.5rem 1.5rem;display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;}
.scoreboard-strip::-webkit-scrollbar{display:none;}
.sb-player{background:var(--bg2);border:1px solid var(--border);border-radius:7px;padding:5px 11px;display:flex;align-items:center;gap:7px;white-space:nowrap;min-width:110px;transition:border-color .3s;}
.sb-player.me{border-color:var(--teal);}
.sb-avatar{font-size:1rem;}
.sb-name{font-size:11px;font-weight:600;}
.sb-score{font-size:11px;font-family:var(--mono);color:var(--amber);}
.game-body{flex:1;padding:1.5rem;max-width:900px;margin:0 auto;width:100%;}
.hub-note{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:1rem 1.25rem;margin-bottom:1.5rem;font-size:13px;color:var(--text2);line-height:1.6;}
.hub-note strong{color:var(--text);}
.room-grid-game{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:13px;}
.rcard{background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:1.25rem;cursor:pointer;transition:all .2s;position:relative;overflow:hidden;}
.rcard::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;}
.rcard.bones::before{background:var(--blue);}
.rcard.joints::before{background:var(--teal);}
.rcard.spine::before{background:var(--purple);}
.rcard.auto::before{background:var(--coral);}
.rcard.meds::before{background:var(--amber);}
.rcard.dosage::before{background:var(--green);}
.rcard.casestudy::before{background:var(--red);}
.rcard:hover:not(.locked){transform:translateY(-3px);border-color:var(--border2);}
.rcard.completed{border-color:#1a5535;background:var(--bg3);}
.rcard.locked{opacity:.4;cursor:not-allowed;}
.rcard-eye{font-size:10px;letter-spacing:1.5px;text-transform:uppercase;font-weight:700;margin-bottom:5px;}
.bones .rcard-eye{color:var(--blue);}
.joints .rcard-eye{color:var(--teal);}
.spine .rcard-eye{color:var(--purple);}
.auto .rcard-eye{color:var(--coral);}
.meds .rcard-eye{color:var(--amber);}
.dosage .rcard-eye{color:var(--green);}
.casestudy .rcard-eye{color:var(--red);}
.rcard-name{font-size:1rem;font-weight:700;margin-bottom:4px;}
.rcard-desc{font-size:12px;color:var(--text2);line-height:1.4;margin-bottom:.75rem;}
.rcard-foot{display:flex;justify-content:space-between;align-items:center;font-size:11px;color:var(--text3);}
.rs-open{background:var(--blue-dim);color:var(--blue);padding:2px 8px;border-radius:20px;font-weight:700;font-size:11px;}
.rs-done{background:var(--green-dim);color:var(--green);padding:2px 8px;border-radius:20px;font-weight:700;font-size:11px;}
.rs-locked{background:#131e28;color:var(--text3);padding:2px 8px;border-radius:20px;font-size:11px;}

/* ════════════════════════════════════════════
   QUESTION SCREEN
════════════════════════════════════════════ */
#qscreen{background:var(--bg);}
.q-header{background:var(--bg2);border-bottom:1px solid var(--border);padding:.875rem 1.5rem;display:flex;align-items:center;gap:.75rem;flex-wrap:wrap;}
.q-header-info{flex:1;}
.q-header-info h2{font-size:.95rem;font-weight:700;}
.q-header-info p{font-size:12px;color:var(--text2);}
.progress-dots{display:flex;gap:5px;}
.pdot{width:8px;height:8px;border-radius:50%;background:var(--bg3);border:1px solid var(--border);transition:all .2s;}
.pdot.done{background:var(--teal);border-color:var(--teal);}
.pdot.active{background:var(--blue);border-color:var(--blue);width:20px;border-radius:4px;}
.answered-tracker{background:var(--bg2);border-bottom:1px solid var(--border);padding:.5rem 1.5rem;display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:11px;color:var(--text3);}
.at-pip{width:7px;height:7px;border-radius:50%;background:var(--text3);}
.at-pip.answered{background:var(--teal);}
.q-body{flex:1;padding:1.5rem;max-width:800px;margin:0 auto;width:100%;}
.q-card{background:var(--bg2);border:1px solid var(--border);border-radius:13px;padding:1.75rem;margin-bottom:1rem;}
.q-meta{display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem;}
.q-num-label{font-size:11px;color:var(--text3);text-transform:uppercase;letter-spacing:1px;}
.q-pts-badge{background:var(--amber-dim);color:var(--amber);font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;}
.q-scenario{background:var(--bg3);border-left:3px solid var(--teal);border-radius:0 8px 8px 0;padding:.875rem 1.125rem;margin-bottom:1.125rem;font-size:13.5px;color:var(--text2);line-height:1.6;}
.q-text{font-size:1rem;line-height:1.6;margin-bottom:1.25rem;color:var(--text);font-weight:500;}
.opts{display:grid;gap:8px;}
.opt-btn{background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:.875rem 1.125rem;cursor:pointer;font-size:13.5px;color:var(--text);text-align:left;transition:all .15s;line-height:1.5;display:flex;gap:10px;align-items:flex-start;}
.opt-btn:hover:not(:disabled){background:#1a3044;border-color:var(--border2);}
.opt-btn.correct{background:var(--green-dim)!important;border-color:var(--green)!important;color:var(--green)!important;}
.opt-btn.wrong{background:var(--red-dim)!important;border-color:var(--red)!important;color:var(--red)!important;}
.opt-btn:disabled{cursor:not-allowed;}
.opt-letter{display:inline-flex;align-items:center;justify-content:center;min-width:22px;height:22px;border-radius:50%;background:var(--bg4);border:1px solid var(--border);font-size:11px;font-weight:700;margin-top:1px;flex-shrink:0;}
/* SATA */
.sata-opt{display:flex;gap:10px;align-items:flex-start;background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:.875rem 1.125rem;cursor:pointer;font-size:13.5px;color:var(--text);transition:all .15s;line-height:1.5;}
.sata-opt:hover:not(.disabled){background:#1a3044;border-color:var(--border2);}
.sata-opt.selected{border-color:var(--teal);background:var(--teal-dim);}
.sata-opt.correct-sel{background:var(--green-dim)!important;border-color:var(--green)!important;color:var(--green)!important;}
.sata-opt.incorrect-sel{background:var(--red-dim)!important;border-color:var(--red)!important;color:var(--red)!important;}
.sata-opt.missed{border-color:var(--amber)!important;color:var(--amber)!important;}
.sata-opt.disabled{cursor:not-allowed;}
.sata-check{width:18px;height:18px;border-radius:4px;background:var(--bg4);border:1.5px solid var(--border2);flex-shrink:0;margin-top:2px;display:flex;align-items:center;justify-content:center;font-size:11px;transition:all .15s;}
.sata-opt.selected .sata-check{background:var(--teal);border-color:var(--teal);color:#000;}
.sata-submit-btn{background:var(--blue-dim);color:var(--blue);border:1px solid var(--blue);border-radius:8px;padding:10px 20px;font-size:13px;font-weight:700;cursor:pointer;margin-top:.75rem;transition:all .15s;}
.sata-submit-btn:hover{background:#0f2d5a;}
/* Dosage */
.formula-block{background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:.875rem 1.125rem;margin-bottom:1.125rem;font-family:var(--mono);font-size:12.5px;color:var(--amber);line-height:2;}
.formula-block strong{color:var(--text);font-family:inherit;}
.dosage-row{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:.875rem;}
.dosage-inp{background:var(--bg3);border:1px solid var(--border2);border-radius:8px;padding:10px 13px;font-size:1rem;color:var(--text);width:140px;font-family:var(--mono);}
.dosage-inp:focus{outline:none;border-color:var(--teal);}
.dosage-unit{font-size:13px;color:var(--text2);}
.btn-submit-dose{background:var(--teal-dim);color:var(--teal);border:1px solid var(--teal);border-radius:8px;padding:10px 18px;font-size:13px;font-weight:700;cursor:pointer;}
.btn-submit-dose:hover{background:#003330;}
.feedback-box{border-radius:8px;padding:.875rem 1.125rem;font-size:13.5px;line-height:1.6;margin-top:.875rem;}
.fb-correct{background:var(--green-dim);border:1px solid var(--green);color:#6ee7a8;}
.fb-wrong{background:var(--red-dim);border:1px solid var(--red);color:#fca08a;}
.first-badge{display:inline-flex;align-items:center;gap:6px;background:var(--amber-dim);border:1px solid var(--amber);color:var(--amber);border-radius:20px;padding:3px 12px;font-size:12px;font-weight:700;margin-top:.5rem;}
.btn-next-q{background:linear-gradient(135deg,#004d45,#112e5e);color:#fff;border:none;border-radius:8px;padding:12px 28px;font-size:14px;font-weight:700;cursor:pointer;display:none;margin-top:.875rem;transition:opacity .2s;}
.btn-next-q.vis{display:inline-block;}
.btn-next-q:hover{opacity:.85;}

/* ════════════════════════════════════════════
   ROOM COMPLETE
════════════════════════════════════════════ */
#rcomplete{background:var(--bg);align-items:center;justify-content:center;padding:2rem;text-align:center;}
.rc-icon{font-size:4rem;margin-bottom:1rem;}
.rc-title{font-size:2rem;font-weight:800;margin-bottom:.5rem;}
.rc-sub{color:var(--text2);max-width:420px;line-height:1.6;margin-bottom:1.75rem;}
.rc-scores{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px;max-width:520px;width:100%;margin-bottom:1.75rem;}
.rc-ps{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:.875rem;text-align:center;}
.rc-ps.winner{border-color:var(--amber);}
.rc-ps-name{font-size:12px;color:var(--text2);margin-bottom:4px;}
.rc-ps-val{font-size:1.5rem;font-weight:800;color:var(--amber);font-family:var(--mono);}
.kf-box{background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:1.5rem;text-align:left;max-width:580px;width:100%;margin-bottom:1.75rem;}
.kf-title{font-size:12px;text-transform:uppercase;letter-spacing:1px;color:var(--text2);margin-bottom:.875rem;font-weight:600;}
.kf-list{list-style:none;display:grid;gap:5px;}
.kf-list li{font-size:13px;color:var(--text2);padding-left:18px;position:relative;line-height:1.45;}
.kf-list li::before{content:'→';position:absolute;left:0;color:var(--teal);font-size:11px;}
.btn-group{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;}

/* ════════════════════════════════════════════
   FINAL
════════════════════════════════════════════ */
#final{background:radial-gradient(ellipse at 50% 30%,#0d2a3a 0%,#07111a 65%);align-items:center;justify-content:center;padding:2rem;text-align:center;}
.final-h1{font-size:clamp(2rem,5vw,3.5rem);font-weight:800;letter-spacing:-2px;margin-bottom:.5rem;}
.cert-card{background:var(--bg2);border:2px solid var(--amber);border-radius:16px;padding:2rem 3rem;max-width:500px;width:100%;margin:1.5rem auto;}
.cert-label{font-size:11px;text-transform:uppercase;letter-spacing:2px;color:var(--amber);margin-bottom:.5rem;}
.podium-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:10px;max-width:500px;width:100%;margin:1.25rem auto;}
.podium-item{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:.875rem;}
.podium-rank{font-size:1.5rem;}
.podium-name{font-size:12px;color:var(--text2);margin:4px 0;}
.podium-score{font-size:1.25rem;font-weight:800;color:var(--amber);font-family:var(--mono);}

/* ════════════════════════════════════════════
   ANSWER SHEET
════════════════════════════════════════════ */
#answersheet{background:var(--bg);}
.as-header{background:var(--bg2);border-bottom:1px solid var(--border);padding:.875rem 1.5rem;display:flex;align-items:center;gap:1rem;flex-wrap:wrap;}
.as-body{flex:1;padding:1.5rem;max-width:950px;margin:0 auto;width:100%;}
.as-tab-bar{display:flex;gap:0;border-bottom:1px solid var(--border);margin-bottom:1.5rem;overflow-x:auto;scrollbar-width:none;}
.as-tab-bar::-webkit-scrollbar{display:none;}
.as-tab{background:transparent;border:none;border-bottom:2px solid transparent;color:var(--text2);padding:9px 14px;font-size:12px;cursor:pointer;white-space:nowrap;transition:all .15s;}
.as-tab.active{color:var(--teal);border-bottom-color:var(--teal);}
.as-q-item{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:1.25rem 1.5rem;margin-bottom:12px;break-inside:avoid;}
.as-q-meta{font-size:11px;color:var(--text3);text-transform:uppercase;letter-spacing:1px;margin-bottom:6px;}
.as-q-scenario{background:var(--bg3);border-left:3px solid var(--teal);padding:.6rem .875rem;border-radius:0 6px 6px 0;font-size:13px;color:var(--text2);margin-bottom:8px;line-height:1.5;}
.as-q-text{font-size:14px;color:var(--text);font-weight:500;margin-bottom:10px;line-height:1.5;}
.as-opts-list{list-style:none;display:grid;gap:4px;margin-bottom:10px;}
.as-opts-list li{font-size:13px;color:var(--text2);padding-left:20px;position:relative;line-height:1.45;}
.as-opts-list li.correct{color:var(--teal);font-weight:600;}
.as-opts-list li::before{content:'○';position:absolute;left:0;font-size:11px;}
.as-opts-list li.correct::before{content:'●';color:var(--teal);}
.as-formula-block{background:var(--bg3);border:1px solid var(--border);border-radius:6px;padding:.6rem .875rem;font-family:var(--mono);font-size:12px;color:var(--amber);margin-bottom:8px;line-height:1.8;}
.as-answer-box{background:var(--green-dim);border:1px solid var(--green);border-radius:6px;padding:.6rem .875rem;font-size:13px;color:var(--green);margin-bottom:8px;font-weight:700;}
.as-rationale{background:var(--bg3);border:1px solid var(--border);border-radius:6px;padding:.6rem .875rem;font-size:13px;color:var(--text2);line-height:1.6;}
.as-kf{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:1.25rem;margin-bottom:1.25rem;}
.as-kf h4{font-size:11px;text-transform:uppercase;letter-spacing:1px;color:var(--text2);margin-bottom:.75rem;}
.as-kf ul{list-style:none;display:grid;gap:5px;}
.as-kf li{font-size:13px;color:var(--text2);padding-left:18px;position:relative;line-height:1.45;}
.as-kf li::before{content:'→';position:absolute;left:0;color:var(--teal);font-size:11px;}
.as-section-hdr{font-size:1.05rem;font-weight:700;margin-bottom:1rem;padding-bottom:.5rem;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:8px;}

@media(max-width:600px){
  .wait-body,.game-body,.q-body,.as-body,.pres-body{padding:1rem;}
  .q-card{padding:1.25rem;}
  .s-content{padding:1.25rem;}
}
@media print{
  body{background:#fff;color:#000;}
  .screen{display:none!important;}
  #answersheet{display:block!important;min-height:unset;}
  .as-header button,.as-tab-bar{display:none;}
