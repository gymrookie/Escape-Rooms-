  .as-answer-box{background:#e6f4ea;color:#1a5c30;border-color:#4caf50;}
  .as-rationale,.as-kf{background:#f5f5f5;color:#333;}
  .as-formula-block{background:#fef9e8;color:#7a5900;}
}
</style>
</head>
