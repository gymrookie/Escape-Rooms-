// ═══════════════════════════════════════════════════
//  ANSWER HANDLERS
// ═══════════════════════════════════════════════════
async function selectAnswer(idx){
  if(S.answered)return;S.answered=true;
  const room=ROOMS.find(r=>r.id===S.currentRoomId);
  const q=room.questions[S.currentQ];
  const correct=idx===q.ans;
  document.querySelectorAll('.opt-btn').forEach(b=>b.disabled=true);
  document.getElementById(`opt-${idx}`).classList.add(correct?'correct':'wrong');
  if(!correct)document.getElementById(`opt-${q.ans}`).classList.add('correct');
  await processAnswer(correct,q.pts);
}

function toggleSata(idx){
  if(S.answered)return;
  const opt=document.getElementById(`sata-${idx}`);
  const check=document.getElementById(`satacheck-${idx}`);
  if(S.sataSelected.has(idx)){S.sataSelected.delete(idx);opt.classList.remove('selected');check.textContent='';}
  else{S.sataSelected.add(idx);opt.classList.add('selected');check.textContent='✓';}
}
async function submitSata(){
  if(S.answered)return;S.answered=true;
  const room=ROOMS.find(r=>r.id===S.currentRoomId);
  const q=room.questions[S.currentQ];
  document.getElementById('sata-sub').style.display='none';
  document.querySelectorAll('.sata-opt').forEach(el=>el.classList.add('disabled'));
  const correctSet=new Set(q.correctSet);
  const selected=S.sataSelected;
  let allCorrect=true;
  q.opts.forEach((_,i)=>{
    const opt=document.getElementById(`sata-${i}`);
    const inCorrect=correctSet.has(i),inSelected=selected.has(i);
    if(inCorrect&&inSelected){opt.classList.remove('selected');opt.classList.add('correct-sel');}
    else if(!inCorrect&&inSelected){opt.classList.remove('selected');opt.classList.add('incorrect-sel');allCorrect=false;}
    else if(inCorrect&&!inSelected){opt.classList.add('missed');allCorrect=false;}
  });
  // partial scoring: award pts proportional
  const totalCorrect=correctSet.size;
  const rightPicks=[...selected].filter(i=>correctSet.has(i)).length;
  const wrongPicks=[...selected].filter(i=>!correctSet.has(i)).length;
  const pct=Math.max(0,(rightPicks-wrongPicks)/totalCorrect);
  const earnedPts=Math.round(q.pts*pct);
  const correct=pct===1;
  await processAnswer(correct,q.pts,null,earnedPts);
}
async function checkDose(){
  if(S.answered)return;
  const room=ROOMS.find(r=>r.id===S.currentRoomId);
  const q=room.questions[S.currentQ];
  const val=parseFloat(document.getElementById('dinp').value);
  if(isNaN(val)){toast('Enter a number','amber');return;}
  S.answered=true;document.getElementById('dinp').disabled=true;
  const correct=Math.abs(val-q.ans)<=q.tolerance;
  await processAnswer(correct,q.pts,val);
}

async function processAnswer(correct,pts,userVal=null,earnedOverride=null){
  const room=ROOMS.find(r=>r.id===S.currentRoomId);
  const q=room.questions[S.currentQ];
  const qKey=`${S.currentRoomId}_${S.currentQ}`;
  let earnedPts=0,firstCorrect=false;
  if(S.isSolo){
    if(correct||earnedOverride!==null){
      earnedPts=earnedOverride!==null?earnedOverride:pts;
      S.myRoomScore+=earnedPts;
    }
    if(!correct&&earnedOverride===null){S.teamHearts=Math.max(0,S.teamHearts-1);}
    renderQHearts();
  } else {
    const rd=await sGet(`rm:${S.roomCode}`,true);
    if(rd){
      const existCorrect=Object.values(rd.answers).some(a=>a.qKey===qKey&&a.isCorrect);
      if(correct){earnedPts=existCorrect?Math.floor(pts*.5):pts;firstCorrect=!existCorrect;}
      else if(earnedOverride!==null&&earnedOverride>0){earnedPts=existCorrect?Math.floor(earnedOverride*.5):earnedOverride;firstCorrect=!existCorrect;}
      else if(!correct&&earnedOverride===null){rd.teamHearts=Math.max(0,(rd.teamHearts||3)-1);}
      if(earnedPts>0&&rd.players[S.myId])rd.players[S.myId].score=(rd.players[S.myId].score||0)+earnedPts;
      S.myRoomScore+=earnedPts;
      if(!rd.answers)rd.answers={};
      rd.answers[S.myId]={qKey,isCorrect:correct,ts:Date.now(),earned:earnedPts};
      S.teamHearts=rd.teamHearts;
      await sSet(`rm:${S.roomCode}`,rd,true);
      renderQHearts();
    }
  }
  const fb=document.getElementById('fb-area');
  let feedbackMsg='';
  if(q.type==='sata'){feedbackMsg=earnedOverride===q.pts?'✅ All correct! ':earnedOverride>0?`⚠️ Partial credit (${earnedOverride}/${pts} pts). `:'❌ Incorrect selection. ';}
  else{feedbackMsg=correct?'✅ Correct! ':'❌ '+(userVal!==null?`Answer: ${userVal}. Correct: ${q.ans} ${q.unit||''}. `:' Incorrect. ');}
  fb.innerHTML=`<div class="feedback-box ${correct||earnedOverride>0?'fb-correct':'fb-wrong'}">${feedbackMsg}${q.explain}</div>
    ${firstCorrect?'<div class="first-badge">⚡ First Correct! Full points</div>':''}
    ${!S.isSolo&&!firstCorrect&&(correct||earnedOverride>0)?'<div class="first-badge" style="background:var(--blue-dim);border-color:var(--blue);color:var(--blue);">✓ Correct — 50% points</div>':''}`;
  document.getElementById('btn-nq').classList.add('vis');
  if(S.teamHearts===0&&!correct&&earnedOverride===null){
    setTimeout(async()=>{
      toast('No hearts! Room restarting...','red',2000);
      if(!S.isSolo){const rd=await sGet(`rm:${S.roomCode}`,true);if(rd){rd.teamHearts=3;await sSet(`rm:${S.roomCode}`,rd,true);}}
      setTimeout(()=>enterRoom(S.currentRoomId),2000);
    },1000);
  }
}
function syncAnswerTracker(rd){
  if(!rd||!rd.answers)return;
  const qKey=`${S.currentRoomId}_${S.currentQ}`;
  const players=Object.values(rd.players);
  const at=document.getElementById('answered-tracker');if(!at)return;
  at.innerHTML=`<span style="font-size:11px;text-transform:uppercase;letter-spacing:1px;color:var(--text3);">Answered:</span>`
    +players.map(p=>{const ans=rd.answers?.[p.id];const done=ans&&ans.qKey===qKey;
      return `<span title="${p.name}" style="display:inline-flex;align-items:center;gap:3px;margin-right:4px;"><span class="at-pip${done?' answered':''}"></span><span style="font-size:11px;color:var(--text3);">${p.name.split(' ')[0]}</span></span>`;
    }).join('');
  renderScoreboard();
}

