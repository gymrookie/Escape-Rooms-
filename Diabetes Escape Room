function openPresentation(){
  buildSlides();
  showScreen('presentation');
  showSlide(0);
}
function buildSlides(){
  const container=document.getElementById('slides-container');
  const dots=document.getElementById('slide-dots');
  container.innerHTML='';dots.innerHTML='';
  document.getElementById('tot-slides').textContent=SLIDES.length;
  SLIDES.forEach((s,i)=>{
    container.innerHTML+=buildSlide(s,i);
    dots.innerHTML+=`<div class="sdot${i===0?' active':''}" onclick="showSlide(${i})" id="sdot-${i}"></div>`;
  });
}
function buildSlide(s,i){
  if(s.type==='hero'){
    return `<div class="slide s-hero${i===0?' active':''}">
      <div class="s-hero-eyebrow">${s.eyebrow}</div>
      <div class="s-hero-title">${s.title.replace('\n','<br>')}</div>
      <div class="s-hero-sub">${s.sub}</div>
      <div class="s-hero-tags">${s.tags.map(t=>`<span class="tag tag-teal">${t}</span>`).join('')}</div>
    </div>`;
  }
  if(s.type==='two-col'){
    const lc=s.left,rc=s.right;
    return `<div class="slide s-content${i===0?' active':''}">
      <div class="s-content-inner">
        <div><div class="slide-eyebrow">${s.eyebrow}</div><div class="slide-h1">${s.title}</div></div>
        <div class="s-two-col">
          <div class="s-col-card"><h3><span class="icon-circle" style="background:${lc.color}22;color:${lc.color}">${lc.icon}</span>${lc.title}</h3><ul>${lc.items.map(it=>`<li>${it}</li>`).join('')}</ul></div>
          <div class="s-col-card"><h3><span class="icon-circle" style="background:${rc.color}22;color:${rc.color}">${rc.icon}</span>${rc.title}</h3><ul>${rc.items.map(it=>`<li>${it}</li>`).join('')}</ul></div>
        </div>
      </div>
    </div>`;
  }
  if(s.type==='icon-grid'){
    const infoHtml=s.info?`<div class="slide-info">${s.info.text}</div>`:'';
    const alertHtml=s.alert?`<div class="slide-alert">${s.alert.text}</div>`:'';
    return `<div class="slide s-content${i===0?' active':''}">
      <div class="s-content-inner">
        <div><div class="slide-eyebrow">${s.eyebrow}</div><div class="slide-h1">${s.title}</div></div>
        ${infoHtml}${alertHtml}
        <div class="s-icon-grid">${s.cards.map(c=>`<div class="icon-card"><div class="ic-dot" style="background:${c.bg}">${c.icon}</div><div class="ic-body"><h4>${c.title}</h4><p>${c.text}</p></div></div>`).join('')}</div>
      </div>
    </div>`;
  }
  if(s.type==='steps'){
    const alertHtml=s.alert?`<div class="slide-alert">${s.alert.text}</div>`:'';
    const infoHtml=s.info?`<div class="slide-info">${s.info.text}</div>`:'';
    return `<div class="slide s-content${i===0?' active':''}">
      <div class="s-content-inner">
        <div><div class="slide-eyebrow">${s.eyebrow}</div><div class="slide-h1">${s.title}</div></div>
        ${alertHtml}${infoHtml}
        <div class="s-steps">${s.steps.map(st=>`<div class="step-item"><div class="step-num">${st.n}</div><div class="step-body"><h4>${st.title}</h4><p>${st.text}</p></div></div>`).join('')}</div>
      </div>
    </div>`;
  }
  return `<div class="slide s-content${i===0?' active':''}"><div style="padding:2rem">${JSON.stringify(s)}</div></div>`;
}
let curSlideIdx=0;
function showSlide(n){
  const slides=document.querySelectorAll('.slide');
  slides.forEach(s=>s.classList.remove('active'));
  slides[n]?.classList.add('active');
  document.querySelectorAll('.sdot').forEach((d,i)=>{
    d.classList.toggle('active',i===n);
    d.classList.toggle('done',i<n&&i!==n);
  });
  document.getElementById('cur-slide').textContent=n+1;
  curSlideIdx=n;
}
function nextSlide(){if(curSlideIdx<SLIDES.length-1)showSlide(curSlideIdx+1);}
function prevSlide(){if(curSlideIdx>0)showSlide(curSlideIdx-1);}
document.addEventListener('keydown',e=>{
  if(document.getElementById('presentation').classList.contains('active')){
    if(e.key==='ArrowRight')nextSlide();
    if(e.key==='ArrowLeft')prevSlide();
  }
});

